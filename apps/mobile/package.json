{
  "name": "@finvault/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "node --test ../../tests/mobile/mobile.test.ts ../../tests/mobile/biometric-bypass.test.ts",
    "test:maestro": "maestro test --driver-host-port 7001 .maestro/",
    "qa:logcat-check": "node scripts/check-logcat.mjs",
    "qa:reset-uiautomator": "adb shell am force-stop dev.mobile.maestro && adb shell am force-stop dev.mobile.maestro.test && adb shell \"pkill -f '[c]om.mobilenext.mobilecli.DeviceServer' || true\"",
    "qa:emulator-start": "node scripts/ensure-emulator.mjs",
    "qa:emulator-stop": "adb emu kill",
    "qa:sync-apk": "node scripts/sync-emulator-apk.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@finvault/db-types": "workspace:*",
    "@finvault/sync-engine": "workspace:*",
    "@supabase/supabase-js": "^2.42.0",
    "expo": "~51.0.0",
    "expo-local-authentication": "~14.0.0",
    "expo-secure-store": "~13.0.0",
    "expo-sqlite": "~14.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "~18.2.45",
    "fast-check": "^3.18.0",
    "typescript": "^5.4.5"
  }
}
