{
  "expo": {
    "name": "FinVault",
    "slug": "finvault",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "finvault",
    "splash": {
      "backgroundColor": "#040A0A"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow FinVault to authenticate using Face ID or biometrics"
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#040A0A"
      },
      "package": "com.finvault.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finvault.app"
    }
  }
}
